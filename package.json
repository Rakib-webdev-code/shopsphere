{
  "name": "shopsphere",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./tests/support/alias-hooks.mjs --test \"tests/**/*.test.mjs\"",
    "test:http": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./tests/support/alias-hooks.mjs --test tests/http.integration.test.mjs",
    "db:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-init.mjs",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-seed.mjs",
    "db:update-product-images": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-update-product-images.mjs",
    "admin:promote": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/promote-admin.mjs"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.11",
    "better-auth": "^1.7.11",
    "mongodb": "^7.7.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
